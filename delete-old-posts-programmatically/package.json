{
  "name": "delete-old-posts-plugin",
  "scripts": {
    "build:css": "tailwindcss -i ./styles.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./styles.css -o ./assets/css/tailwind.css --watch",
    "start:message": "echo 'Watching for code changes.  Start making changes!'",
    "watch:php": "onchange 'inc/*.php' -- npm run build:css",
    "start": "npm run start:message & npm run watch:php & npm run watch:css"
  },
  "dependencies": {
    "onchange": "^7.1.0",
    "postcss-import": "^14.0.1",
    "postcss-loader": "^7.0.1",
    "tom-select": "^2.4.1"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^3.1.3",
    "autoprefixer": "^10.4.8",
    "postcss": "^8.4.35",
    "postcss-cli": "^8.3.1",
    "tailwindcss": "^3.1.8"
  }
}
