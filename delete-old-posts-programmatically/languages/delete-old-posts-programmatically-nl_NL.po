msgstr ""
"Nieuwe omleiding naar bericht (volledige URL, beginnend met https:// of "
"http://):"

#: inc/class-delete-old-posts-redirects.php:305
msgid "It's NOT valid URL."
msgstr "Dit is GEEN geldige URL."

#: inc/class-delete-old-posts-redirects.php:312
